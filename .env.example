# Copy to .env and fill in. .env is git-ignored.

# Local Postgres from docker-compose.yml
POSTGRES_USER=gea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gea
DATABASE_URL=postgresql://gea:change-me@localhost:5432/gea

# Only needed for enrichment (M2). Fine-grained token, public repos read-only.
GITHUB_TOKEN=

# Optional ingest tuning (defaults shown)
# INGEST_MIN_DAILY_STARS=1
# INGEST_MIN_DAILY_FORKS=1
