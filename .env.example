# Copy to .env and fill in. .env is git-ignored.

# Local Postgres from docker-compose.yml
POSTGRES_USER=gea
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gea
DATABASE_URL=postgresql://gea:change-me@localhost:5432/gea

# Only needed for enrichment (M2). Fine-grained token, public repos read-only.
GITHUB_TOKEN=

# BigQuery ingest (ingest.bigquery): your Google Cloud project id
GOOGLE_CLOUD_PROJECT=
# BQ_CANDIDATES=200000
# BQ_MAX_GB=150

# Optional tuning (defaults shown)
# DATA_DIR=          (default: <repo>/data/daily; relative paths resolve from the working dir)
# TRACKED_REPOS=25000
# CANDIDATE_FACTOR=4
# WEIGHT_STARS=1
# WEIGHT_FORKS=2
# WEIGHT_PUSHES=0.5
